{
  "manifest_version": 3,
  "name": "Y-akuza",
  "version": "5.0.0",
  "description": "YouTube stripped to just the player.",
  "permissions": ["storage", "tabs", "declarativeNetRequest"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.googlevideo.com/*",
    "*://*.ytimg.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["*://*.youtube.com/*"],
    "js": ["content.js"],
    "css": ["style.css"],
    "run_at": "document_start"
  }],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Y-akuza"
  },
  "declarative_net_request": {
    "rule_resources": [{ "id": "ruleset_1", "enabled": true, "path": "rules.json" }]
  },
  "web_accessible_resources": [{
    "resources": ["injected.js"],
    "matches": ["*://*.youtube.com/*"]
  }],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
